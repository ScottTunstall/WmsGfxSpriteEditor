<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Williams Graphics Sprite Editor"
           Manufacturer="Scott Tunstall"
           Version="$(ProductVersion)"
           UpgradeCode="51608157-0C9C-4DA8-8AC3-759483B0726E"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\WmsGfxSpriteEditor\hulk-fancy.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="Allows users to edit the sprites in classic Williams arcade games." />
    <Property Id="ARPCONTACT" Value="Scott Tunstall" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="!(bind.Property.ProductName)">
        <Files Include="$(PublishDir)**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut"
                  Name="Williams Graphics Sprite Editor"
                  Target="[INSTALLFOLDER]WmsGfxSpriteEditor.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Scott Tunstall\WmsGfxSpriteEditor" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>
</Wix>
